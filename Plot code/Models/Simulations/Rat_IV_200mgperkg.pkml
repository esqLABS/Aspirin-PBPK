                <ValueOrigin id="26" source="Publication" description="Niederalt, C., Kuepfer, L., Solodenko, J. et al. J Pharmacokinet Pharmacodyn (2017). https://doi.org/10.1007/s10928-017-9559-4" />
                <Info min="0" flag="50" seq="43" ref="0" bb="2" group="19" />
              </Parameter>
              <Parameter id="P8Jhf35WkkWwWFEQbFxaHA" name="Use pH- and pKa-dependent penalty factor for charged molecule fraction" description="Penalty factor for charged molecule fraction is used for &quot;Intestinal permeability (transcellular)&quot; only" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="75" />
              </Parameter>
              <Parameter id="ruXVbguYtUaDX_zzsKoOCg" name="Enable supersaturation" description="Enabling supersaturation inactivates the limit of how much solute can be dissolved. It should always and only be allowed in combination with particle dissolution formulations; otherwise disabled. Enabling in case of other formulations results in a lack of the solubility limit and hence in infinitely soluble solutes." icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="14" />
              </Parameter>
