              <Parameter id="qAgCVyQyj06FNa-H_J7yBg" name="Fraction unbound (plasma, reference value)" description="Fraction unbound in plasma of the reference individual, i.e. in the case of human typically an average healthy adult. This reference value can be scaled to children based on the ontogeny of the respective plasma protein and/or in diseased subjects using the plasma protein scale factor defined in the individual" icon="Parameter" persistable="0" isFixedValue="1" dim="Fraction" quantityType="Parameter" negativeValuesAllowed="1" formula="RBVS93nz7EudfkiYalEFYg" buildMode="Global" isDefault="0" value="0.47" displayUnit="%">
