                <Info min="0" flag="50" seq="43" ref="0" bb="2" group="19" />
              </Parameter>
              <Parameter id="0fOHBYsed0qJo5wHSSJ4aw" name="Use pH- and pKa-dependent penalty factor for charged molecule fraction" description="Penalty factor for charged molecule fraction is used for &quot;Intestinal permeability (transcellular)&quot; only" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="75" />
              </Parameter>
              <Parameter id="6e50VBm-NkOVyn7bhkGBFA" name="Enable supersaturation" description="Enabling supersaturation inactivates the limit of how much solute can be dissolved. It should always and only be allowed in combination with particle dissolution formulations; otherwise disabled. Enabling in case of other formulations results in a lack of the solubility limit and hence in infinitely soluble solutes." icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="14" />
              </Parameter>
