                    <Formula id="EOtfxaVnY0OA1xNb5bCmuA" name="PARAM_CLSpec_endosomal_global" dim="Inversed time" formula="K_uptake-K_rec&gt;=0 ? K_uptake-K_rec : 0">
                      <Paths>
