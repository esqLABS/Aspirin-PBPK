              <Parameter id="88ncmuzhK0aoR5sk7wFlmg" name="Enable supersaturation" description="Enabling supersaturation inactivates the limit of how much solute can be dissolved. It should always and only be allowed in combination with particle dissolution formulations; otherwise disabled. Enabling in case of other formulations results in a lack of the solubility limit and hence in infinitely soluble solutes." icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="14" />
              </Parameter>
