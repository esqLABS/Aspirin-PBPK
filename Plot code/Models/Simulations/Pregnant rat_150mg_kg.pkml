              </Parameter>
              <Parameter id="CisxipCC3UCWtAfZdUjWXg" name="Kd (FcRn) in plasma/interstitial" description="Dissociation constant of drug for binding to FcRn in plasma/interstitial space. For monoclonal antibodies the binding to FcRn in neutral environment (plasma and interstitial space) is generally very weak or not detectable. In this case the high default value for Kd(FcRn) in plasma/interstitial can be kept." icon="Parameter" persistable="0" isFixedValue="0" dim="Concentration (molar)" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="999999" displayUnit="µmol/l">
                <ValueOrigin id="26" source="Publication" description="Niederalt, C., Kuepfer, L., Solodenko, J. et al. J Pharmacokinet Pharmacodyn (2017). https://doi.org/10.1007/s10928-017-9559-4" />
