                <Info min="0" flag="50" seq="41" ref="0" bb="2" group="19" />
              </Parameter>
              <Parameter id="ggrKY58hEkKz_zC0m1et6Q" name="Kd (FcRn) in plasma/interstitial" description="Dissociation constant of drug for binding to FcRn in plasma/interstitial space. For monoclonal antibodies the binding to FcRn in neutral environment (plasma and interstitial space) is generally very weak or not detectable. In this case the high default value for Kd(FcRn) in plasma/interstitial can be kept." icon="Parameter" persistable="0" isFixedValue="0" dim="Concentration (molar)" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="999999" displayUnit="µmol/l">
                <ValueOrigin id="26" source="Publication" description="Niederalt, C., Kuepfer, L., Solodenko, J. et al. J Pharmacokinet Pharmacodyn (2017). https://doi.org/10.1007/s10928-017-9559-4" />
                <Info min="0" flag="50" seq="42" ref="0" bb="2" group="19" />
              </Parameter>
              <Parameter id="pYO0yc70P0ileWPlsLSXxQ" name="kass (FcRn)" description="Association constant of drug for binding to FcRn" icon="Parameter" persistable="0" isFixedValue="0" dim="Second order rate constant" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0.87" displayUnit="l/µmol/min">
                <ValueOrigin id="26" source="Publication" description="Niederalt, C., Kuepfer, L., Solodenko, J. et al. J Pharmacokinet Pharmacodyn (2017). https://doi.org/10.1007/s10928-017-9559-4" />
                <Info min="0" flag="50" seq="43" ref="0" bb="2" group="19" />
              </Parameter>
              <Parameter id="qC1f_KC3F0uBluDLyZPaFg" name="Use pH- and pKa-dependent penalty factor for charged molecule fraction" description="Penalty factor for charged molecule fraction is used for &quot;Intestinal permeability (transcellular)&quot; only" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="75" />
              </Parameter>
              <Parameter id="pxqhBTyXJEaPg22s_12tiQ" name="Enable supersaturation" description="Enabling supersaturation inactivates the limit of how much solute can be dissolved. It should always and only be allowed in combination with particle dissolution formulations; otherwise disabled. Enabling in case of other formulations results in a lack of the solubility limit and hence in infinitely soluble solutes." icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0">
                <Info min="0" max="1" flag="50" seq="100" ref="0" bb="2" group="14" />
              </Parameter>
